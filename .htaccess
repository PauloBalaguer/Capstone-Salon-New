# Allow this laptop and devices connected to its Windows mobile hotspot.
<RequireAny>
  Require local
  Require ip 192.168.137.0/24
</RequireAny>

# This project is still under active development, so CSS/JS/HTML
# edits need to show up on the next reload instead of getting stuck
# behind the browser's own cache (no Cache-Control header here means
# Chrome falls back to guessing how long a file is "fresh", which can
# easily hide an edit for many minutes). Turn caching off for the
# assets that change during a dev/demo session.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# Private credential files (legacy Brevo, PayMongo, SMS) are include-only, never a public endpoint.
<FilesMatch "^(?:brevo|paymongo|mail|sms)_credentials\.php(?:\..*)?$">
  Require all denied
</FilesMatch>

# Environment, Composer and project files. The real .env belongs outside htdocs;
# this blocks one that is copied here by mistake, plus .env.example.
<FilesMatch "^(?:\.env.*|composer\.(?:json|lock)|package(?:-lock)?\.json|skills-lock\.json|vercel\.json|Dockerfile.*|.*\.(?:md|sql|log))$">
  Require all denied
</FilesMatch>

# Never list a folder's contents.
Options -Indexes

# Not for the browser: packages, dev-only scripts and data, session files and
# the include-only backend code. Dot-folders too (.git), except .well-known,
# which hosts use to issue the HTTPS certificate.
RedirectMatch 404 /vendor/
RedirectMatch 404 /(?:database|tests|node_modules|docker)(?:/|$)
RedirectMatch 404 /backend/shared(?:/|$)
RedirectMatch 404 /\.(?!well-known)
