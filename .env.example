# Template only (tracked by Git) -- never put real keys here.
# Copy to C:\xampp\salon-private\.env, or set SALON_SECRETS_DIR to another folder.
# Server environment variables override the file.

APP_ENV=local
APP_DEBUG=false

# PayMongo: use sk_test_/pk_test_ until verified.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Brevo: regular API key (not SMTP); sender must be verified.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Leo Mejillano Salon & Beauty"

# textbee.dev
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Late-arrival grace in minutes (placeholder value). Empty hides the rule.
SALON_LATE_GRACE_MINUTES=15

# Optional: cleaning buffer after each service (default 30).
# SALON_CLEANING_BUFFER_MINUTES=30
