# Template only -- never put real keys in this file (it is tracked by Git).
#
# Copy it to C:\xampp\salon-private\.env (outside htdocs) and fill in the
# values there. To keep the file somewhere else, set SALON_SECRETS_DIR to
# that folder. On a hosting server you can instead set these same names as
# environment variables in the control panel; those win over the file.

APP_ENV=local
APP_DEBUG=false

# Live server only: the site's public address, no trailing slash. Emailed links
# use it, and when it starts with https:// login cookies become HTTPS-only.
# APP_URL=https://your-domain.com

# Live server only: from the host's database page. Leave out for local XAMPP,
# which uses 127.0.0.1:3306, new_capstone_salon, root and no password. Put a
# password in double quotes if it contains spaces, # or $.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=
# DB_USERNAME=
# DB_PASSWORD=""
# Encrypts the connection when the database is on another network (Vercel).
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Vercel containers only. A long random string; Vercel Cron sends it to runCron.php.
# CRON_SECRET=
# The image already sets this; uses the php_sessions table (migration 057).
# SESSION_DRIVER=database

# PayMongo Dashboard > Developers > API Keys. Use sk_test_/pk_test_ until verified.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# whsk_... returned when the webhook is registered.
PAYMONGO_WEBHOOK_SECRET=

# Brevo > SMTP & API > API Keys (a regular API key, not an SMTP key).
BREVO_API_KEY=
# A sender address verified in Brevo.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Leo Mejillano Salon & Beauty"

# textbee.dev dashboard: API key, and the registered Android phone's device ID.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Late-arrival grace period, in whole minutes. PLACEHOLDER -- the salon still
# has to decide the real value. When set, the rule is shown to customers in the
# booking Terms & Conditions, confirmation screens and emails, and staff see in
# the arrival review whether a customer is within it. Leave it empty to hide
# the rule. It never cancels a booking or marks a no-show by itself; staff decide.
SALON_LATE_GRACE_MINUTES=15

# Optional: minutes kept free after every service for cleaning (default 30).
# SALON_CLEANING_BUFFER_MINUTES=30

# Adding the private settings to Vercel. Run each command, then paste the value
# when asked. From the private .env, copy only the part after the =, without quotes.
#
#   vercel env add DB_PASSWORD --environment production --sensitive           MariaDB page, copy icon next to the password
#   vercel env add PAYMONGO_SECRET_KEY --environment production --sensitive   .env (starts with sk_test_)
#   vercel env add PAYMONGO_PUBLIC_KEY --environment production --sensitive   .env (starts with pk_test_)
#   vercel env add BREVO_API_KEY --environment production --sensitive         .env
#   vercel env add BREVO_SENDER_EMAIL --environment production --sensitive    .env
#   vercel env add TEXTBEE_API_KEY --environment production --sensitive       .env
#   vercel env add TEXTBEE_DEVICE_ID --environment production --sensitive     .env
