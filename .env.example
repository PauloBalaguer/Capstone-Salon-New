# Template only -- never put real keys in this file (it is tracked by Git).
#
# Copy it to C:\xampp\salon-private\.env (outside htdocs) and fill in the
# values there. To keep the file somewhere else, set SALON_SECRETS_DIR to
# that folder. On a hosting server you can instead set these same names as
# environment variables in the control panel; those win over the file.

APP_ENV=local
APP_DEBUG=false

# PayMongo Dashboard > Developers > API Keys. Use sk_test_/pk_test_ until verified.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# whsk_... returned when the webhook is registered.
PAYMONGO_WEBHOOK_SECRET=

# Brevo > SMTP & API > API Keys (a regular API key, not an SMTP key).
BREVO_API_KEY=
# A sender address verified in Brevo.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Leo Mejillano Salon & Beauty"

# textbee.dev dashboard: API key, and the registered Android phone's device ID.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
